# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres connection string (Project Settings → Database → Connection string).
# The transaction pooler (port 6543) works; the app disables prepared statements for it.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TOKEN_DAYS=7
JWT_REFRESH_TOKEN_DAYS=30

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medicine-agent

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Used by `npm run db:seed` when no company exists yet
SEED_COMPANY_NAME=My Company
